{
  "schemaVersion": 1,
  "gdsVersion": "2.6.4",
  "productArchetype": "public",
  "supportedEntryPoints": [
    "@doneisbetter/gds/client",
    "@doneisbetter/gds/server"
  ],
  "requiredContracts": [
    "PublicShell",
    "PageHeader",
    "EditorialHero",
    "FeatureBand",
    "PublicProductCard",
    "PublicBrandFooter",
    "AccentPanel",
    "EmptyState",
    "ChoiceChip",
    "StatusBadge",
    "FormField"
  ],
  "localAdapters": [
    {
      "contract": "Theme extension",
      "path": "src/theme/gds-theme.ts",
      "status": "active"
    },
    {
      "contract": "Root provider",
      "path": "src/app/providers.tsx",
      "status": "active"
    },
    {
      "contract": "Public page composition",
      "path": "src/app/page.tsx",
      "status": "active"
    }
  ],
  "approvedExceptions": [
    {
      "contract": "Branding and layout CSS overrides",
      "path": "src/app/globals.css",
      "status": "active",
      "reason": "Laura still relies on product-local presentation rules, including some selectors against Mantine-rendered structure, so the repo is GDS-governed but not yet 100% free of local visual overrides."
    }
  ],
  "compliance": {
    "documentationPaths": [
      "README.md",
      "GDS_ADOPTION_STATUS.md"
    ],
    "staleDocumentationReferences": [
      "@gds/",
      "vendor/gds",
      "GENERAL_DESIGN_SYSTEM"
    ],
    "protectedSurfacePaths": [
      "src/app",
      "src/theme"
    ],
    "bannedImports": [
      "@gds/core",
      "@gds/theme",
      "tailwindcss"
    ]
  },
  "migrationStatus": "governed",
  "owner": "lauraorganic",
  "lastReviewedAt": "2026-05-31"
}
